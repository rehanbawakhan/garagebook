# Copy this file to .env.local and fill in your own values. Never commit .env.local.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=garagebook_db

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=garagebook

# Long random string used to sign login cookies (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string
